# 常駐サービスが読み込む設定ファイルのひな形。~/.config/kanata-nicola/config.env にコピーし、使用する行の # を削除して編集する。
# 変更は systemctl --user restart kanata-nicola で反映する。書式、各設定の用途と既定値、設定値の調べ方は docs/settings.md。

# NICOLA_IME_SYNC=1  # NICOLA を IME の実際の状態に追従させる（fcitx5＋Mozc に対応）
# NICOLA_KEYS_AS_CTRL=KEY_CAPSLOCK  # Ctrl として扱うキー（デスクトップのキー配列の設定で Ctrl に変更したキー）
# NICOLA_THUMB_KEYS=KEY_SPACE:KEY_HENKAN  # 左右の親指キー（左:右）
# NICOLA_LAYOUT_OVERLAYS=practical:lag-tolerant  # 配列差分ファイル（docs/layout-overlays.md）
# NICOLA_EXTRA_KBD=user-extra.kbd  # 追加の kanata の設定ファイル（キーの再割り当て等）
# NICOLA_INCLUDE_DEVICES="AT Translated Set 2 keyboard"  # 対象にするキーボードの名前
# NICOLA_EXCLUDE_DEVICES="Example Extra Buttons"  # 除外するキーボードの名前
# NICOLA_WAIT_DEVICE_MS=  # キーボードの接続時に、kanata が入力デバイスを探し直す前に待つ時間（ms）
# NICOLA_KANATA_PORT=  # IME 同期で使用する kanata の TCP ポート
# NICOLA_KANATA_BIN=/usr/local/bin/kanata  # 使用する kanata の実行ファイル（修正を適用した kanata 以外を指定する場合の注意は docs/settings.md）
